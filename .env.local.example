# Copy to .env.local and fill in. Never commit .env.local.

# Required in production. Without it the contact API returns 500 instead of
# silently discarding enquiries. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Destination for form submissions.
# CONTACT_TO_EMAIL=info@nycalb.com

# Optional. Sender address — must be on a domain verified in Resend.
# CONTACT_FROM_EMAIL=NYC Alb Services <noreply@nycalb.com>

# Optional. Mirror every lead to an external endpoint (Zapier, Make, CRM).
# LEAD_WEBHOOK_URL=
