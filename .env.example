# Copy this file to .env.local and fill in your values.
# Email forms will still show success in development without these set.

# SMTP settings (works with Gmail, iCloud, Zoho, any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Gmail: use an App Password from https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on your Google account)
