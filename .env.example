# Copy this file to .env.local and fill in your values.
# Email forms will still show success in development without this set
# (submissions are logged to the console instead of sent).

# ------------------------------------------------------------------
# Resend API key  (https://resend.com → API Keys)
# ------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------
# Vercel deployment
# ------------------------------------------------------------------
# 1. Go to your Vercel project → Settings → Environment Variables
# 2. Add:  RESEND_API_KEY  =  <your key>
# 3. Redeploy — no other email-related variables are needed.

# ------------------------------------------------------------------
# Switching to the production recipient
# ------------------------------------------------------------------
# Open lib/email-config.ts and change:
#   TO_EMAIL      →  'info@nycalb.com'
#   FROM_ADDRESS  →  'NYC Alb Services <noreply@nycalb.com>'
#                    (requires nycalb.com to be verified in Resend)
